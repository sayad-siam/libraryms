<div class="row">
    {{#books}}
    <div class="col-12 col-sm-4 col-md-3 my-3">
        <a class="btn bg-white" href="/book/view/{{id}}">
            <div class="card">
                <img src="/images/{{Image}}" class="card-img-top" alt="{{Title}}" style="height: 595;">

                <div class="card-body">
                    <h5 class="card-title text-success" style="white-space:nowrap;overflow:hidden;">{{Title}}</h5>
                    <p class="card-text text-info-emphasis" style="white-space:nowrap;overflow:hidden;">{{Author}}</p>
                </div>
            </div>
        </a>
    </div>
    {{/books}}
